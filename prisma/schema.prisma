generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}
enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  TO_CLEAN
  BLOCKED
}
enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}
enum OrderStatus {
  OPEN
  SENT
  PREPARING
  PARTIALLY_READY
  READY
  DELIVERED
  PAID
  CANCELLED
}
enum TicketStatus {
  NEW
  PREPARING
  READY
  DELIVERED
  CANCELLED
}
enum ProductType {
  DISH
  BEVERAGE
  COMBO
  EXTRA
}
enum InventoryMovementType {
  PURCHASE
  SALE
  RECIPE_CONSUMPTION
  RETURN
  ADJUSTMENT
  LOSS
  DAMAGE
  EXPIRATION
  INTERNAL_USE
  CANCELLATION
  INITIAL_STOCK
}
enum CashSessionStatus {
  OPEN
  CLOSED
}
enum CashMovementType {
  SALE
  INCOME
  EXPENSE
  WITHDRAWAL
  DEPOSIT
  REFUND
  ADJUSTMENT
}
enum PaymentMethod {
  CASH
  YAPE
  PLIN
  CARD
  TRANSFER
  CREDIT
  OTHER
}
enum DocumentType {
  PRECHECK
  RECEIPT
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}
enum DocumentStatus {
  PENDING
  GENERATED
  SENDING
  ACCEPTED
  REJECTED
  OBSERVED
  VOIDED
  ERROR
  PENDING_SEND
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  firstName     String
  lastName      String
  status        UserStatus  @default(ACTIVE)
  failedLogins  Int         @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  roles         UserRole[]
  sessions      Session[]
  auditLogs     AuditLog[]
  orders        Order[]     @relation("WaiterOrders")
  cashSessions  CashSession[]
  @@index([status])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  system      Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model RestaurantSettings {
  id              String   @id @default("singleton")
  legalName       String
  tradeName       String
  ruc             String?
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  currency        String   @default("PEN")
  timezone        String   @default("America/Lima")
  igvRate         Decimal  @default(18) @db.Decimal(5,2)
  updatedAt       DateTime @updatedAt
}

model RestaurantTable {
  id          String      @id @default(cuid())
  number      Int         @unique
  name        String?
  capacity    Int
  status      TableStatus @default(FREE)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orders      Order[]
  @@index([status, active])
}

model Station {
  id        String          @id @default(cuid())
  name      String          @unique
  active    Boolean         @default(true)
  products  Product[]
  tickets   KitchenTicket[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String       @id @default(cuid())
  name             String
  shortName        String?
  description      String?
  type             ProductType  @default(DISH)
  price            Decimal      @db.Decimal(12,2)
  estimatedMinutes Int?
  active           Boolean      @default(true)
  available        Boolean      @default(true)
  categoryId       String
  stationId        String?
  category         Category     @relation(fields: [categoryId], references: [id])
  station          Station?     @relation(fields: [stationId], references: [id])
  recipeItems      RecipeItem[]
  orderItems       OrderItem[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
  @@index([categoryId, available, active])
  @@index([stationId])
}

model Ingredient {
  id          String              @id @default(cuid())
  name        String              @unique
  unit        String
  stock       Decimal             @default(0) @db.Decimal(14,3)
  minStock    Decimal?            @db.Decimal(14,3)
  maxStock    Decimal?            @db.Decimal(14,3)
  averageCost Decimal             @default(0) @db.Decimal(14,4)
  active      Boolean             @default(true)
  recipeItems RecipeItem[]
  movements   InventoryMovement[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model RecipeItem {
  productId    String
  ingredientId String
  quantity     Decimal    @db.Decimal(14,3)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  @@id([productId, ingredientId])
}

model Order {
  id          String           @id @default(cuid())
  number      Int              @unique @default(autoincrement())
  type        OrderType
  status      OrderStatus      @default(OPEN)
  tableId     String?
  waiterId    String?
  notes       String?
  subtotal    Decimal          @default(0) @db.Decimal(12,2)
  discount    Decimal          @default(0) @db.Decimal(12,2)
  tax         Decimal          @default(0) @db.Decimal(12,2)
  total       Decimal          @default(0) @db.Decimal(12,2)
  openedAt    DateTime         @default(now())
  sentAt      DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?
  table       RestaurantTable? @relation(fields: [tableId], references: [id])
  waiter      User?            @relation("WaiterOrders", fields: [waiterId], references: [id])
  items       OrderItem[]
  tickets     KitchenTicket[]
  sale        Sale?
  @@index([status, openedAt])
  @@index([tableId, status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Decimal  @db.Decimal(10,3)
  unitPrice Decimal  @db.Decimal(12,2)
  discount  Decimal  @default(0) @db.Decimal(12,2)
  notes     String?
  total     Decimal  @db.Decimal(12,2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  @@index([orderId])
}

model KitchenTicket {
  id          String       @id @default(cuid())
  orderId     String
  stationId   String
  status      TicketStatus @default(NEW)
  sentAt      DateTime     @default(now())
  startedAt   DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station     Station      @relation(fields: [stationId], references: [id])
  @@index([stationId, status, sentAt])
}

model InventoryMovement {
  id           String                @id @default(cuid())
  ingredientId String
  type         InventoryMovementType
  quantity     Decimal               @db.Decimal(14,3)
  unitCost     Decimal?              @db.Decimal(14,4)
  balanceAfter Decimal               @db.Decimal(14,3)
  reference    String?
  reason       String?
  createdAt    DateTime              @default(now())
  ingredient   Ingredient            @relation(fields: [ingredientId], references: [id])
  @@index([ingredientId, createdAt])
}

model Sale {
  id          String           @id @default(cuid())
  orderId     String           @unique
  subtotal    Decimal          @db.Decimal(12,2)
  discount    Decimal          @default(0) @db.Decimal(12,2)
  tax         Decimal          @db.Decimal(12,2)
  total       Decimal          @db.Decimal(12,2)
  createdAt   DateTime         @default(now())
  cancelledAt DateTime?
  order       Order            @relation(fields: [orderId], references: [id])
  payments    Payment[]
  documents   FiscalDocument[]
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12,2)
  reference String?
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  @@index([saleId])
}

model CashRegister {
  id       String        @id @default(cuid())
  name     String        @unique
  active   Boolean       @default(true)
  sessions CashSession[]
}

model CashSession {
  id            String            @id @default(cuid())
  registerId    String
  userId        String
  status        CashSessionStatus @default(OPEN)
  openingAmount Decimal           @db.Decimal(12,2)
  expectedCash  Decimal?          @db.Decimal(12,2)
  countedCash   Decimal?          @db.Decimal(12,2)
  difference    Decimal?          @db.Decimal(12,2)
  openedAt      DateTime          @default(now())
  closedAt      DateTime?
  register      CashRegister      @relation(fields: [registerId], references: [id])
  user          User              @relation(fields: [userId], references: [id])
  movements     CashMovement[]
  @@index([registerId, status])
}

model CashMovement {
  id        String           @id @default(cuid())
  sessionId String
  type      CashMovementType
  amount    Decimal          @db.Decimal(12,2)
  reason    String?
  reference String?
  createdAt DateTime         @default(now())
  session   CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}

model FiscalDocument {
  id          String         @id @default(cuid())
  saleId      String
  type        DocumentType
  status      DocumentStatus @default(PENDING)
  series      String?
  correlativo Int?
  xml         String?
  response    String?
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sale        Sale           @relation(fields: [saleId], references: [id])
  @@unique([type, series, correlativo])
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  @@index([module, createdAt])
  @@index([entity, entityId])
}
